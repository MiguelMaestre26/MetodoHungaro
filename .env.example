# Copia este archivo como .env y coloca tus credenciales reales.
# Clave de API de Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a utilizar. Alternativas disponibles:
# gemini-3.5-flash, gemini-3.8-flash, gemini-3-flash-preview, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash
